{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      ".read": false,
      ".write": false,
      "$pin": {
        ".validate": "$pin.matches(/^[0-9]{6}$/)",
        "$other": { ".validate": false },

        "meta": {
          ".read": true,
          ".write": "!data.exists() || !newData.exists()",
          ".validate": "newData.hasChildren(['createdAt', 'hostId'])",
          "createdAt": { ".validate": "newData.isNumber()" },
          "hostId": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "$other": { ".validate": false }
        },

        "players": {
          ".read": true,
          ".write": true,
          "$connId": {
            ".validate": "$connId.matches(/^[0-9a-f]{16}$/) && newData.hasChildren(['joinedAt'])",
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "toHost": {
          ".write": true,
          "$connId": {
            ".read": true,
            ".validate": "$connId.matches(/^[0-9a-f]{16}$/)",
            "$pushId": {
              ".validate": "newData.hasChildren(['d']) && newData.child('d').isString() && newData.child('d').val().length <= 1000000",
              "d": { ".validate": true },
              "$other": { ".validate": false }
            }
          }
        },

        "toPlayer": {
          ".write": true,
          "$connId": {
            ".read": true,
            ".validate": "$connId.matches(/^[0-9a-f]{16}$/)",
            "$pushId": {
              ".validate": "newData.hasChildren(['d']) && newData.child('d').isString() && newData.child('d').val().length <= 1000000",
              "d": { ".validate": true },
              "$other": { ".validate": false }
            }
          }
        }
      }
    }
  }
}
